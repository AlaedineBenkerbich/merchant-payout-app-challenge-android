<?xml version="1.0" encoding="utf-8"?>
<!--
   The device identifier identifies one installation on one device, so it must not be copied
   to the cloud or to a new phone. Backups are also disabled in the manifest; these rules keep
   the intent explicit for any path that still honours them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_identity.xml" />
    </device-transfer>
</data-extraction-rules>
